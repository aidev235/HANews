# Copy to .env for local use. HANews itself reads process environment variables;
# use your shell, direnv, or another secret manager to load this file.
OPENAI_API_KEY=

# Optional overrides.
HANEWS_ROOT=
HANEWS_CONFIG_DIR=config
HANEWS_GIT_AUTHOR_NAME=HANews Bot
HANEWS_GIT_AUTHOR_EMAIL=hanews-bot@users.noreply.github.com

